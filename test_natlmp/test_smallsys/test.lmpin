### ---preamble--- ###
log ./test.log
units micro 
atom_style hybrid dipole sphere bond
boundary p p f 
 
neighbor 1.0 bin 
neigh_modify every 1 delay 1 check yes
pair_style hybrid lj/cut/dipole/cut 1 20

### ---Create Particles and Region--- ###

region 1 block -7.5 7.5 -7.5 7.5 -1.95 1.95
create_box 1 1 
create_atoms 1 random 10 1235 NULL
pair_coeff 1 1 lj/cut/dipole/cut 0.01 2.49451641079295 2.8 20

group Atoms type 1 
mass * 1

### ---Variables--- ###
## magnetic field
variable Bmag atom 1.937538437640465e-05
variable freq atom 1.5e-06
variable theta atom 0.46949356878647464
variable phi atom 0.0

variable fieldx atom v_Bmag*cos(v_freq*time*2*PI+v_phi)*sin(v_theta)
variable fieldy atom v_Bmag*sin(v_freq*time*2*PI+v_phi)*sin(v_theta)
variable fieldz atom v_Bmag*cos(v_theta)

### ---Fixes--- ###
fix 	1 Atoms set 1 0 group all dipole v_fieldx v_fieldy v_fieldz
fix 	2 Atoms brownian 300 738159 gamma_t 0.001 

fix     3 Atoms addforce 0 0 -0.00011264159515495175 #Weight
fix 	6 Atoms wall/lj126 zlo EDGE 0.01 1.247258205396475  1.4 zhi EDGE 0.01 1.247258205396475  1.4  #ZWalls LJ

### ---Run Commands--- ###
timestep 	100.0 
dump 	3 all custom 333 ./test.lammpstrj id type x	 y	 z
thermo_style 	custom step atoms
thermo 	100  
run 	1000000 
